# Trivial stack used for the lock, overwrite and prefix tests.
# Backend values come from a backend.hcl generated by the scripts (non-secret values only).

terraform {
  required_version = ">= 1.12.0"
  backend "oci" {}
}

variable "revision" {
  type    = string
  default = "1"
}

# Set > 0 to hold the state lock during apply (lock test).
variable "hold_seconds" {
  type    = number
  default = 0
}

resource "terraform_data" "probe" {
  input            = var.revision
  triggers_replace = [var.revision] # replace => provisioner (sleep) runs on every revision change

  provisioner "local-exec" {
    command = "sleep ${var.hold_seconds}"
  }
}

output "revision" { value = terraform_data.probe.output }
